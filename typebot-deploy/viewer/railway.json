{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "typebot-deploy/viewer/Dockerfile",
    "rootDirectory": "/"
  },
  "deploy": {
    "startCommand": "/bin/sh -c 'node apps/viewer/server.js'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
