          "options": {
            "url": "https://autogest-production-404d.up.railway.app/api/webhook/search-vehicles",
            "method": "POST",
            "body": "{\"query\":\"{{var-modelo}}\"}",
            "responseVariableId": "var-resposta-estoque"
